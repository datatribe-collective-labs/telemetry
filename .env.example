# Database configuration for TimescaleDB (Docker) and Python pipelines
# Copy this file to .env and adjust if needed

# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# Optional: Full database URL (overrides the three vars above if set)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# Optional: where the dashboard finds the backend (default: http://localhost:8000;
# the Docker Compose dashboard service sets http://backend:8000 itself)
# BACKEND_URL=http://localhost:8000

# Optional: auto-reload for the native backend (`python -m backend.main`); off unless 1
# BACKEND_RELOAD=1

# Airflow (compose profile "airflow"). The defaults are for local use only:
# set both to long random values on a server (e.g. `openssl rand -hex 32`);
# docker-compose.prod.yml refuses to start without them.
# Changing AIRFLOW_ADMIN_PASSWORD takes effect on the next start of airflow-init.
# Note: POSTGRES_PASSWORD is put into connection URLs as-is, so keep it to URL-safe
# characters (letters, digits, - _ .); `openssl rand -hex 32` qualifies.
# AIRFLOW_ADMIN_PASSWORD=admin
# AIRFLOW_JWT_SECRET=dev-only-change-me

# Production only (docker-compose.prod.yml): the public hostname Caddy serves the
# dashboard on over HTTPS. No domain: the server IP with dashes + .sslip.io
# (e.g. 95-111-22-33.sslip.io). `localhost` for a local check.
# PUBLIC_HOSTNAME=95-111-22-33.sslip.io

# Optional: demo replay of the simulator (physics_models service)
# 1.0 = real time; 60 = the 9-day flight in ~3.5 h
# PHYSICS_MODELS_TIME_SCALE=1.0
# Mission time to start from, in seconds after liftoff (12300 = where Orion starts moving)
# PHYSICS_MODELS_START_MET_SECONDS=0.0
# 1 = start over at the end of the NASA trajectory data (on in docker-compose.prod.yml)
# PHYSICS_MODELS_LOOP=0

# Optional: NASA DONKI API base URL (default: https://ccmc.gsfc.nasa.gov/DONKI-API/get)
# DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API/get

# Optional: JPL CAD API base URL (default: https://ssd-api.jpl.nasa.gov/cad.api)
# JPL_CAD_BASE_URL=https://ssd-api.jpl.nasa.gov/cad.api

# Optional: NASA CCMC iSWA HAPI base URL (default: https://iswa.gsfc.nasa.gov/IswaSystemWebApp/hapi)
# ISWA_HAPI_BASE_URL=https://iswa.gsfc.nasa.gov/IswaSystemWebApp/hapi