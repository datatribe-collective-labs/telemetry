# Copy to .env and adjust as needed.
# Nothing loads .env automatically - pass it explicitly, e.g.
#   uv run --env-file .env --package pipelines python -m pipelines.ingest.jpl_cad

# Used by pipelines/db.py and streamlit_dashboard/data/engine.py
# Note: port 5433, not 5432 - a native Postgres install may already own 5432.
DATABASE_URL=postgresql://telemetry:telemetry@localhost:5433/telemetry

# JPL SSD Close-Approach Data API.
# Fair-use policy: one request at a time, no guaranteed availability.
# https://ssd-api.jpl.nasa.gov/doc/cad.html
JPL_CAD_BASE_URL=https://ssd-api.jpl.nasa.gov/cad.api

# Default query window for pipelines.ingest.jpl_cad (each is overridable by
# the matching CLI flag, e.g. --date-max). Values shown are the defaults.
# CAD_DATE_MIN=now
# CAD_DATE_MAX=+60
# CAD_DIST_MAX=0.05
# CAD_BODY=Earth