# Copy to .env and adjust as needed.

# Used by pipelines/db.py and streamlit_dashboard/db.py
# Note: port 5433, not 5432 - a native Postgres install may already own 5432.
DATABASE_URL=postgresql://telemetry:telemetry@localhost:5433/telemetry

# JPL SSD Close-Approach Data API.
# Fair-use policy: one request at a time, no guaranteed availability.
# https://ssd-api.jpl.nasa.gov/doc/cad.html
JPL_CAD_BASE_URL=https://ssd-api.jpl.nasa.gov/cad.api